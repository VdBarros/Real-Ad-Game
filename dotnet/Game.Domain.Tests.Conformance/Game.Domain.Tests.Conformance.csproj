<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the test sources a second time, the way the Editor compiles them,
       and runs nothing. Game.Domain.Tests must carry a runnable TFM and a runnable
       NUnit to host the test adapter, and both are wider than Unity's: its sources
       can bind a BCL API Unity does not have, and an NUnit API added after 3.5.
       This project closes both gaps by recompiling the same files at
       UnityTargetFramework against UnityNUnitVersion, so either kind of break
       fails `dotnet test dotnet/Game.Domain.Tests` — which builds this project
       through a ReferenceOutputAssembly="false" reference without linking it —
       instead of surfacing in the Editor after a green merge.

       NU1701: NUnit 3.5 predates netstandard2.0 and has only .NET Framework
       assemblies. Resolving them against netstandard2.1 is deliberate — the
       Editor's own nunit.framework is a net472 build, and this project is never
       loaded or run, only compiled. -->

  <PropertyGroup>
    <TargetFramework>$(UnityTargetFramework)</TargetFramework>
    <AssemblyName>Game.Domain.Tests.Conformance</AssemblyName>
    <RootNamespace>Game.Domain.Tests</RootNamespace>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ScriptsRoot)Domain.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Domain\Game.Domain.csproj" />
    <ProjectReference Include="..\Game.Presentation.Pure\Game.Presentation.Pure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="$(UnityNUnitVersion)" />
  </ItemGroup>

</Project>
