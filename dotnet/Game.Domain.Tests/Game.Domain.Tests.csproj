<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only runnable project in the fast loop: `dotnet test dotnet/Game.Domain.Tests`.
       A test host cannot target netstandard2.1, so this project carries a modern
       runtime TFM while the code under test lives in Game.Domain and
       Game.Presentation.Pure, both pinned to Unity's netstandard2.1. The C# 9
       ceiling from Directory.Build.props still applies to the test sources.
       NUnit is held at 3.x because Unity 6000.5.9f1 ships nunit.framework 3.5;
       NUnit 4 would let tests compile here and fail in the Editor. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Game.Domain.Tests</AssemblyName>
    <RootNamespace>Game.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same source files Unity compiles into the Game.Domain.Tests asmdef. -->
    <Compile Include="$(ScriptsRoot)Domain.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Domain\Game.Domain.csproj" />
    <ProjectReference Include="..\Game.Presentation.Pure\Game.Presentation.Pure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
